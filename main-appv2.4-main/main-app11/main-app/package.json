{
  "name": "main-app",
  "version": "3.47.1",
  "description": "Personal gaming & productivity launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o styles/vendor/tailwind.css --minify",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "ryota",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "electron": "^42.0.0",
    "electron-builder": "^24.9.1",
    "tailwindcss": "3.4.17"
  },
  "build": {
    "appId": "com.launcher.app",
    "productName": "main",
    "files": [
      "main.js",
      "main.html",
      "preload.js",
      "logger.js",
      "license-gate.html",
      "license-gate-preload.js",
      "main/**/*",
      "renderer/**/*",
      "styles/**/*",
      "mic-mute-overlay.html",
      "mic-mute-overlay-preload.js",
      "crosshair-overlay.html",
      "crosshair-overlay-preload.js",
      "icons/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "main",
      "artifactName": "main-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "main-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
