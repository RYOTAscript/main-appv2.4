// Prisma schema for the "main" website.
//
// Postgres in every environment (SQLite doesn't work on Vercel's ephemeral
// filesystem). Use a hosted Postgres — Neon / Vercel Postgres / Supabase — and
// set DATABASE_URL to its connection string. For serverless, prefer the
// "non-pooling"/direct URL for a low-traffic app. See README "Database".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth (Auth.js) models ──────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  license       License?
  purchases     Purchase[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Commerce models ────────────────────────────────────────────────────────
// One active lifetime license per user, provisioned by the Stripe webhook.
model License {
  id         String   @id @default(cuid())
  key        String   @unique // MAIN-XXXX-XXXX-XXXX-XXXX
  userId     String   @unique
  active     Boolean  @default(true)
  issuedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per completed payment. Keyed by the processor's order id
// (`externalId`) so captures/webhook retries are idempotent (see @unique).
model Purchase {
  id         String   @id @default(cuid())
  userId     String
  provider   String   @default("paypal") // "paypal" | "stripe"
  externalId String   @unique // PayPal order id — the idempotency key
  captureId  String? // PayPal capture id
  amount     Int // in the smallest currency unit (cents)
  currency   String   @default("usd")
  status     String   @default("complete")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
